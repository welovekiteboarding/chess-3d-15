{
  "name": "chess-3d-15",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest",
    "format": "prettier --check README.md index.html package.json package-lock.json tsconfig.json tsconfig.app.json tsconfig.node.json eslint.config.js prettier.config.js .prettierrc \"src/**/*.{ts,tsx,css}\"",
    "format:write": "prettier --write README.md index.html package.json package-lock.json tsconfig.json tsconfig.app.json tsconfig.node.json eslint.config.js prettier.config.js .prettierrc \"src/**/*.{ts,tsx,css}\""
  },
  "dependencies": {
    "@react-three/fiber": "8.17.10",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.30.3",
    "three": "0.171.0"
  },
  "devDependencies": {
    "@eslint/js": "9.15.0",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.0.1",
    "@types/node": "22.9.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@types/three": "^0.171.0",
    "@vitejs/plugin-react": "4.3.4",
    "eslint": "9.15.0",
    "eslint-plugin-react-hooks": "5.0.0",
    "eslint-plugin-react-refresh": "0.4.14",
    "globals": "15.12.0",
    "jsdom": "25.0.1",
    "prettier": "3.3.3",
    "typescript": "5.6.3",
    "typescript-eslint": "8.14.0",
    "vite": "5.4.11",
    "vitest": "2.1.5"
  }
}
